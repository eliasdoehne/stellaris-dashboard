msgstr[1] "%(envoys)s i %(num)s innych wysłanników"
msgstr[2] "%(envoys)s i %(num)s innych wysłanników"

#. stands for a planet that the ledger has no record of
#: stellarisdashboard/dashboard_app/event_registry.py:225
msgid "an unknown planet"
msgstr "nieznana planeta"

#. a planet and its class, inserted into sentences, e.g. "the Gaia World Terra".
#. %(planet_class)s is the planet class, e.g. "Gaia World", %(planet)s the name of the planet (a link).
#: stellarisdashboard/dashboard_app/event_registry.py:232
#, python-format
msgid "the %(planet_class)s %(planet)s"
msgstr "%(planet)s (%(planet_class)s)"

#. a war without a name in the game, e.g. "Empire A vs Empire B war".
#. %(war)s is the link to the war, named after its sides.
#: stellarisdashboard/dashboard_app/event_registry.py:247
#, python-format
msgid "%(war)s war"
msgstr "wojna %(war)s"

#. %(country)s is the name of the empire (a link), usually reads like "United Nations of Earth"
#: stellarisdashboard/dashboard_app/event_registry.py:458
#, python-format
msgid ""
"The %(country)s came through a dimensional portal and invaded the galaxy, starting the end-game "
"crisis."
msgstr ""
"Imperium %(country)s przeszło przez portal wymiarowy i najechało galaktykę, rozpoczynając kryzys "
"końcowy."

#: stellarisdashboard/dashboard_app/event_registry.py:459
#, python-format
msgid "The %(country)s came through a second dimensional portal."
msgstr "Imperium %(country)s przeszło przez drugi portal wymiarowy."

#: stellarisdashboard/dashboard_app/event_registry.py:460
#, python-format
msgid "The %(country)s came through a third dimensional portal."
msgstr "Imperium %(country)s przeszło przez trzeci portal wymiarowy."

#: stellarisdashboard/dashboard_app/event_registry.py:461
#: stellarisdashboard/dashboard_app/event_registry.py:462
#: stellarisdashboard/dashboard_app/event_registry.py:463
#, python-format
msgid "The %(country)s lost their dimensional portal."
msgstr "Imperium %(country)s utraciło swój portal wymiarowy."

#: stellarisdashboard/dashboard_app/event_registry.py:464
#, python-format
msgid "The %(country)s were defeated, ending the extradimensional invasion."
msgstr "Imperium %(country)s zostało pokonane, co zakończyło inwazję z innego wymiaru."

#: stellarisdashboard/dashboard_app/event_registry.py:465
#, python-format
msgid "The %(country)s arrived from beyond the galaxy, starting the end-game crisis."
msgstr "Imperium %(country)s przybyło spoza galaktyki, rozpoczynając kryzys końcowy."

#: stellarisdashboard/dashboard_app/event_registry.py:466
#, python-format
msgid "The %(country)s were defeated, ending the Prethoryn invasion."
msgstr "Imperium %(country)s zostało pokonane, co zakończyło inwazję Prethorynów."

#: stellarisdashboard/dashboard_app/event_registry.py:467
#, python-format
msgid "The %(country)s awoke, starting the end-game crisis."
msgstr "Imperium %(country)s przebudziło się, rozpoczynając kryzys końcowy."

#: stellarisdashboard/dashboard_app/event_registry.py:468
#, python-format
msgid "The %(country)s were defeated when their last machine world fell."
msgstr "Imperium %(country)s zostało pokonane po upadku jego ostatniego świata maszyn."

#: stellarisdashboard/dashboard_app/event_registry.py:469
#, python-format
msgid "The %(country)s appeared, starting the end-game crisis."
msgstr "Imperium %(country)s pojawiło się, rozpoczynając kryzys końcowy."

#: stellarisdashboard/dashboard_app/event_registry.py:470
#, python-format
msgid "The %(country)s declared war on the galaxy."
msgstr "Imperium %(country)s wypowiedziało wojnę galaktyce."

#: stellarisdashboard/dashboard_app/event_registry.py:471
#, python-format
msgid "The %(country)s prevailed over the galaxy."
msgstr "Imperium %(country)s zatriumfowało nad galaktyką."

#: stellarisdashboard/dashboard_app/event_registry.py:472
#, python-format
msgid "The %(country)s were defeated, ending the crisis."
msgstr "Imperium %(country)s zostało pokonane, co zakończyło kryzys."

#: stellarisdashboard/dashboard_app/event_registry.py:473
#, python-format
msgid "The %(country)s emerged as the Gray Tempest."
msgstr "Imperium %(country)s ujawniło się jako Szara Burza."

#: stellarisdashboard/dashboard_app/event_registry.py:474
#, python-format
msgid "The %(country)s were defeated, ending the Gray Tempest."
msgstr "Imperium %(country)s zostało pokonane, co zakończyło Szarą Burzę."

#: stellarisdashboard/dashboard_app/event_registry.py:475
#, python-format
msgid "The %(country)s spread across the galaxy, starting the Voidworm Plague."
msgstr "Imperium %(country)s rozprzestrzeniło się po galaktyce, rozpoczynając Plagę Pustoczerwi."

#: stellarisdashboard/dashboard_app/event_registry.py:476
#, python-format
msgid "The %(country)s receded, ending the Voidworm Plague."
msgstr "Imperium %(country)s ustąpiło, co zakończyło Plagę Pustoczerwi."

#: stellarisdashboard/dashboard_app/event_registry.py:477
#, python-format
msgid "The %(country)s united under the Great Khan and set out to conquer the galaxy."
msgstr "Imperium %(country)s zjednoczyło się pod władzą Wielkiego Chana i wyruszyło na podbój galaktyki."

#: stellarisdashboard/dashboard_app/event_registry.py:478
#, python-format
msgid "The %(country)s lost the Great Khan's armada in battle; the Khan fled to raise a new one."
msgstr "Imperium %(country)s straciło w bitwie armadę Wielkiego Chana; Chan uciekł, by zebrać nową."

#: stellarisdashboard/dashboard_app/event_registry.py:479
#, python-format
msgid "The %(country)s lost the Great Khan, who died, leaving the horde without its leader."
msgstr "Imperium %(country)s utraciło Wielkiego Chana, który zginął, pozostawiając Ordę bez przywódcy."

#: stellarisdashboard/dashboard_app/event_registry.py:480
#, python-format
msgid "The %(country)s entered the War in Heaven."
msgstr "Imperium %(country)s przystąpiło do Wojny w Niebie."

#: stellarisdashboard/dashboard_app/event_registry.py:481
#, python-format
msgid "The %(country)s saw the War in Heaven end."
msgstr "Imperium %(country)s doczekało końca Wojny w Niebie."

#: stellarisdashboard/dashboard_app/event_registry.py:482
#, python-format
msgid "The %(country)s spread, escalating the crisis to stage 2 of 4."
msgstr "Imperium %(country)s rozprzestrzeniło się, zaostrzając kryzys do etapu 2 z 4."

#: stellarisdashboard/dashboard_app/event_registry.py:483
#, python-format
msgid "The %(country)s spread further, escalating the crisis to stage 3 of 4."
msgstr "Imperium %(country)s rozprzestrzeniło się jeszcze dalej, zaostrzając kryzys do etapu 3 z 4."

#: stellarisdashboard/dashboard_app/event_registry.py:484
#, python-format
msgid "The %(country)s overran the galaxy, escalating the crisis to its final stage."
msgstr "Imperium %(country)s opanowało galaktykę, doprowadzając kryzys do etapu ostatecznego."

#: stellarisdashboard/dashboard_app/event_registry.py:485
#, python-format
msgid "The %(country)s were declared a crisis to the galaxy."
msgstr "Imperium %(country)s zostało uznane za zagrożenie dla galaktyki."

#: stellarisdashboard/dashboard_app/event_registry.py:486
#, python-format
msgid "The %(country)s awoke from their long slumber."
msgstr "Imperium %(country)s przebudziło się z długiego snu."

#: stellarisdashboard/dashboard_app/event_registry.py:487
#, python-format
msgid "The %(country)s awoke from their long slumber, alarmed by the rise of the younger empires."
msgstr ""
"Imperium %(country)s przebudziło się z długiego snu, zaniepokojone wzrostem potęgi młodszych "
"imperiów."

#: stellarisdashboard/dashboard_app/event_registry.py:488
#, python-format
msgid "The %(country)s awoke from their long slumber to guard the galaxy against the end-game crisis."
msgstr "Imperium %(country)s przebudziło się z długiego snu, by chronić galaktykę przed kryzysem końcowym."

#: stellarisdashboard/dashboard_app/event_registry.py:489
#, python-format
msgid "The %(country)s awoke without an ancient rival, so no War in Heaven will follow."
msgstr "Imperium %(country)s przebudziło się bez dawnego rywala, więc Wojna w Niebie nie wybuchnie."

#: stellarisdashboard/dashboard_app/event_registry.py:490
#, python-format
msgid ""
"The %(country)s were chosen as the ancient rival of the awakened empire, fated to wake and "
"contest it."
msgstr ""
"Imperium %(country)s zostało wybrane na dawnego rywala przebudzonego imperium; jest mu "
"przeznaczone przebudzić się i stanąć z nim w szranki."

#: stellarisdashboard/dashboard_app/event_registry.py:491
#, python-format
msgid ""
"The %(country)s awoke as the ancient rival of the awakened empire, setting the War in Heaven in "
"motion."
msgstr ""
"Imperium %(country)s przebudziło się jako dawny rywal przebudzonego imperium, wprawiając w ruch "
"Wojnę w Niebie."

#: stellarisdashboard/dashboard_app/event_registry.py:492
#, python-format
msgid "The %(country)s founded the League of Non-Aligned Powers, to stay out of the War in Heaven."
msgstr ""
"Imperium %(country)s założyło Ligę Państw Niezaangażowanych, by trzymać się z dala od Wojny w "
"Niebie."

#: stellarisdashboard/dashboard_app/event_registry.py:493
#, python-format
msgid "The %(country)s led the League of Non-Aligned Powers into war against the awakened empires."
msgstr ""
"Imperium %(country)s poprowadziło Ligę Państw Niezaangażowanych do wojny z przebudzonymi "
"imperiami."

#: stellarisdashboard/dashboard_app/event_registry.py:494
#, python-format
msgid "The %(country)s lost a war, shattering the myth of Fallen Empire invincibility."
msgstr "Imperium %(country)s przegrało wojnę, burząc mit o niepokonaniu Upadłych Imperiów."

