msgstr "Dirigeant"

#: stellarisdashboard/dashboard_app/event_registry.py:82
msgctxt "leader class"
msgid "Envoy"
msgstr "Envoyé"

#. a leader as shown in the ledger: their class, then their name as a link,
#. e.g. "Scientist Jane Doe". %(leader_class)s is the class, e.g. "Scientist".
#: stellarisdashboard/dashboard_app/event_registry.py:92
#, python-format
msgctxt "leader with class"
msgid "%(leader_class)s %(leader)s"
msgstr "%(leader_class)s %(leader)s"

#. stands for a leader that the ledger has no record of, at the start of a sentence
#. ("An unknown leader died or retired.")
#. and inside a sentence ("The X hired an unknown leader.")
#: stellarisdashboard/dashboard_app/event_registry.py:109
msgid "An unknown leader"
msgstr "Un dirigeant inconnu"

#: stellarisdashboard/dashboard_app/event_registry.py:109
msgid "an unknown leader"
msgstr "un dirigeant inconnu"

#. %(envoys)s is a list of leaders, e.g. "Scientist A, Official B, Official C".
#. %(num)s is the number of further envoys.
#: stellarisdashboard/dashboard_app/event_registry.py:123
#, python-format
msgid "%(envoys)s and %(num)s other envoy"
msgid_plural "%(envoys)s and %(num)s other envoys"
msgstr[0] "%(envoys)s et %(num)s autre envoyé"
msgstr[1] "%(envoys)s et %(num)s autres envoyés"

#. stands for a planet that the ledger has no record of
#: stellarisdashboard/dashboard_app/event_registry.py:137
msgid "an unknown planet"
msgstr "une planète inconnue"

#. a planet and its class, inserted into sentences, e.g. "the Gaia World Terra".
#. %(planet_class)s is the planet class, e.g. "Gaia World", %(planet)s the name of the planet (a link).
#: stellarisdashboard/dashboard_app/event_registry.py:144
#, python-format
msgid "the %(planet_class)s %(planet)s"
msgstr "la planète %(planet)s (%(planet_class)s)"

#. a war without a name in the game, e.g. "Empire A vs Empire B conflict".
#. %(war)s is the link to the war, named after its sides.
#: stellarisdashboard/dashboard_app/event_registry.py:160
#, python-format
msgid "%(war)s conflict"
msgstr "Conflit %(war)s"

#. a war without a name in the game, e.g. "Empire A vs Empire B war".
#. %(war)s is the link to the war, named after its sides.
#: stellarisdashboard/dashboard_app/event_registry.py:163
#, python-format
msgid "%(war)s war"
msgstr "Guerre %(war)s"

#. %(country)s is the name of the empire (a link), usually reads like "United Nations of Earth"
#: stellarisdashboard/dashboard_app/event_registry.py:330
#, python-format
msgid ""
"The %(country)s came through a dimensional portal and invaded the galaxy, starting the end-game "
"crisis."
msgstr ""
"L'empire %(country)s a traversé un portail dimensionnel et envahi la galaxie, déclenchant la "
"crise de fin de partie."

#: stellarisdashboard/dashboard_app/event_registry.py:331
#, python-format
msgid "The %(country)s came through a second dimensional portal."
msgstr "L'empire %(country)s a traversé un deuxième portail dimensionnel."

#: stellarisdashboard/dashboard_app/event_registry.py:332
#, python-format
msgid "The %(country)s came through a third dimensional portal."
msgstr "L'empire %(country)s a traversé un troisième portail dimensionnel."

#: stellarisdashboard/dashboard_app/event_registry.py:333
#: stellarisdashboard/dashboard_app/event_registry.py:334
#: stellarisdashboard/dashboard_app/event_registry.py:335
#, python-format
msgid "The %(country)s lost their dimensional portal."
msgstr "L'empire %(country)s a perdu son portail dimensionnel."

#: stellarisdashboard/dashboard_app/event_registry.py:336
#, python-format
msgid "The %(country)s were defeated, ending the extradimensional invasion."
msgstr "L'empire %(country)s a été vaincu, mettant fin à l'invasion extradimensionnelle."

#: stellarisdashboard/dashboard_app/event_registry.py:337
#, python-format
msgid "The %(country)s arrived from beyond the galaxy, starting the end-game crisis."
msgstr "L'empire %(country)s est arrivé d'au-delà de la galaxie, déclenchant la crise de fin de partie."

#: stellarisdashboard/dashboard_app/event_registry.py:338
#, python-format
msgid "The %(country)s were defeated, ending the Prethoryn invasion."
msgstr "L'empire %(country)s a été vaincu, mettant fin à l'invasion prethoryn."

#: stellarisdashboard/dashboard_app/event_registry.py:339
#, python-format
msgid "The %(country)s awoke, starting the end-game crisis."
msgstr "L'empire %(country)s s'est éveillé, déclenchant la crise de fin de partie."

#: stellarisdashboard/dashboard_app/event_registry.py:340
#, python-format
msgid "The %(country)s were defeated when their last machine world fell."
msgstr "L'empire %(country)s a été vaincu après la chute de son dernier monde machine."

#: stellarisdashboard/dashboard_app/event_registry.py:341
#, python-format
msgid "The %(country)s appeared, starting the end-game crisis."
msgstr "L'empire %(country)s est apparu, déclenchant la crise de fin de partie."

#: stellarisdashboard/dashboard_app/event_registry.py:342
#, python-format
msgid "The %(country)s declared war on the galaxy."
msgstr "L'empire %(country)s a déclaré la guerre à la galaxie."

#: stellarisdashboard/dashboard_app/event_registry.py:343
#, python-format
msgid "The %(country)s prevailed over the galaxy."
msgstr "L'empire %(country)s a triomphé de la galaxie."

#: stellarisdashboard/dashboard_app/event_registry.py:344
#, python-format
msgid "The %(country)s were defeated, ending the crisis."
msgstr "L'empire %(country)s a été vaincu, mettant fin à la crise."

#: stellarisdashboard/dashboard_app/event_registry.py:345
#, python-format
msgid "The %(country)s emerged as the Gray Tempest."
msgstr "L'empire %(country)s est apparu sous le nom de Tempête grise."

#: stellarisdashboard/dashboard_app/event_registry.py:346
#, python-format
msgid "The %(country)s were defeated, ending the Gray Tempest."
msgstr "L'empire %(country)s a été vaincu, mettant fin à la Tempête grise."

#: stellarisdashboard/dashboard_app/event_registry.py:347
#, python-format
msgid "The %(country)s spread across the galaxy, starting the Voidworm Plague."
msgstr "L'empire %(country)s s'est répandu dans la galaxie, déclenchant la Peste des vers du Vide."

#: stellarisdashboard/dashboard_app/event_registry.py:348
#, python-format
msgid "The %(country)s receded, ending the Voidworm Plague."
msgstr "L'empire %(country)s a reculé, mettant fin à la Peste des vers du Vide."

#: stellarisdashboard/dashboard_app/event_registry.py:349
#, python-format
msgid "The %(country)s united under the Great Khan and set out to conquer the galaxy."
msgstr "L'empire %(country)s s'est uni sous le Grand Khan et est parti à la conquête de la galaxie."

#: stellarisdashboard/dashboard_app/event_registry.py:350
#, python-format
msgid "The %(country)s lost the Great Khan's armada in battle; the Khan fled to raise a new one."
msgstr ""
"L'empire %(country)s a perdu l'armada du Grand Khan au combat ; le Khan s'est enfui pour en lever"
" une nouvelle."

#: stellarisdashboard/dashboard_app/event_registry.py:351
#, python-format
msgid "The %(country)s lost the Great Khan, who died, leaving the horde without its leader."
msgstr "L'empire %(country)s a perdu le Grand Khan, mort au combat, laissant la horde sans chef."

#: stellarisdashboard/dashboard_app/event_registry.py:352
#, python-format
msgid "The %(country)s entered the War in Heaven."
msgstr "L'empire %(country)s est entré dans la Guerre des cieux."

#: stellarisdashboard/dashboard_app/event_registry.py:353
#, python-format
msgid "The %(country)s saw the War in Heaven end."
msgstr "L'empire %(country)s a vu la Guerre des cieux prendre fin."

#: stellarisdashboard/dashboard_app/event_registry.py:354
#, python-format
msgid "The %(country)s spread, escalating the crisis to stage 2 of 4."
msgstr "L'empire %(country)s s'est étendu, faisant passer la crise à l'étape 2 sur 4."

#: stellarisdashboard/dashboard_app/event_registry.py:355
#, python-format
msgid "The %(country)s spread further, escalating the crisis to stage 3 of 4."
msgstr "L'empire %(country)s s'est encore étendu, faisant passer la crise à l'étape 3 sur 4."

#: stellarisdashboard/dashboard_app/event_registry.py:356
#, python-format
msgid "The %(country)s overran the galaxy, escalating the crisis to its final stage."
msgstr "L'empire %(country)s a submergé la galaxie, faisant passer la crise à son étape finale."

#: stellarisdashboard/dashboard_app/event_registry.py:357
#, python-format
msgid "The %(country)s were declared a crisis to the galaxy."
msgstr "L'empire %(country)s a été déclaré crise pour la galaxie."

#: stellarisdashboard/dashboard_app/event_registry.py:358
#, python-format
msgid "The %(country)s awoke from their long slumber."
msgstr "L'empire %(country)s s'est réveillé de son long sommeil."

#: stellarisdashboard/dashboard_app/event_registry.py:359
#, python-format
msgid "The %(country)s awoke from their long slumber, alarmed by the rise of the younger empires."
msgstr ""
"L'empire %(country)s s'est réveillé de son long sommeil, alarmé par l'ascension des empires plus "
"jeunes."

#: stellarisdashboard/dashboard_app/event_registry.py:360
#, python-format
msgid "The %(country)s awoke from their long slumber to guard the galaxy against the end-game crisis."
msgstr ""
"L'empire %(country)s s'est réveillé de son long sommeil pour protéger la galaxie contre la crise "
"de fin de partie."

#: stellarisdashboard/dashboard_app/event_registry.py:361
#, python-format
msgid "The %(country)s awoke without an ancient rival, so no War in Heaven will follow."
msgstr ""
"L'empire %(country)s s'est réveillé sans rival ancestral : aucune Guerre des cieux n'aura donc "
"lieu."

#: stellarisdashboard/dashboard_app/event_registry.py:362
#, python-format
msgid ""
"The %(country)s were chosen as the ancient rival of the awakened empire, fated to wake and "
"contest it."
msgstr ""
"L'empire %(country)s a été choisi comme rival ancestral de l'empire éveillé, destiné à s'éveiller"
" pour l'affronter."

#: stellarisdashboard/dashboard_app/event_registry.py:363
#, python-format
msgid ""
"The %(country)s awoke as the ancient rival of the awakened empire, setting the War in Heaven in "
"motion."
msgstr ""
"L'empire %(country)s s'est réveillé en tant que rival ancestral de l'empire éveillé, déclenchant "
"la Guerre des cieux."

#: stellarisdashboard/dashboard_app/event_registry.py:364
#, python-format
msgid "The %(country)s founded the League of Non-Aligned Powers, to stay out of the War in Heaven."
msgstr ""
"L'empire %(country)s a fondé la Ligue des puissances non alignées pour rester à l'écart de la "
"Guerre des cieux."

#: stellarisdashboard/dashboard_app/event_registry.py:365
#, python-format
msgid "The %(country)s led the League of Non-Aligned Powers into war against the awakened empires."
msgstr ""
"L'empire %(country)s a mené la Ligue des puissances non alignées à la guerre contre les empires "
"éveillés."

#: stellarisdashboard/dashboard_app/event_registry.py:366
#, python-format
msgid "The %(country)s lost a war, shattering the myth of Fallen Empire invincibility."
msgstr "L'empire %(country)s a perdu une guerre, brisant le mythe de l'invincibilité des empires déchus."

#: stellarisdashboard/dashboard_app/event_registry.py:1295
msgid "excavating"
msgstr "fouille en cours"

#: stellarisdashboard/dashboard_app/event_registry.py:1295
msgid "fully excavated"
msgstr "fouille terminée"

#: stellarisdashboard/dashboard_app/event_registry.py:1295
#: stellarisdashboard/dashboard_app/event_registry.py:1311
msgid "paused"
msgstr "en pause"

#: stellarisdashboard/dashboard_app/event_registry.py:1311
msgid "exploring"
msgstr "exploration en cours"

#: stellarisdashboard/dashboard_app/event_registry.py:1311
msgid "fully explored"
msgstr "exploration terminée"

#: stellarisdashboard/dashboard_app/event_registry.py:1326
msgid "in progress"
msgstr "en cours"

#: stellarisdashboard/dashboard_app/event_registry.py:1326
msgid "contact made"
msgstr "contact établi"

#: stellarisdashboard/dashboard_app/event_registry.py:1326
msgid "abandoned"
msgstr "abandonné"

#. %(country)s: name of an empire (a link), usually reads like "United Nations of Earth"
#: stellarisdashboard/dashboard_app/event_registry.py:REGISTRY[acquired_relic]:5
#, python-format
msgid "The %(country)s acquired the \"%(relic)s\" relic."
msgstr "L'empire %(country)s a acquis la relique « %(relic)s »."

#. %(leader)s: class and name of a leader (a link), e.g. "Scientist Jane Doe". %(country)s: name of an
#. empire (a link), usually reads like "United Nations of Earth"
#: stellarisdashboard/dashboard_app/event_registry.py:REGISTRY[agenda_launch]:6
#, python-format
msgid "Under the rule of %(leader)s, the %(country)s launched the agenda \"%(agenda)s\"."
msgstr "Sous la direction de %(leader)s, l'empire %(country)s a lancé l'agenda « %(agenda)s »."

#. %(country)s: name of an empire (a link), usually reads like "United Nations of Earth"
#: stellarisdashboard/dashboard_app/event_registry.py:REGISTRY[agenda_launch]:9
#, python-format
msgid "The %(country)s launched the agenda \"%(agenda)s\"."
msgstr "L'empire %(country)s a lancé l'agenda « %(agenda)s »."

#. %(leader)s: class and name of a leader (a link), e.g. "Scientist Jane Doe". %(country)s: name of an
#. empire (a link), usually reads like "United Nations of Earth"
#: stellarisdashboard/dashboard_app/event_registry.py:REGISTRY[agenda_preparation]:7
#, python-format
msgid "Under the rule of %(leader)s, the %(country)s prepared a new agenda \"%(agenda)s\"."
msgstr "Sous la direction de %(leader)s, l'empire %(country)s a préparé un nouvel agenda « %(agenda)s »."

#. %(country)s: name of an empire (a link), usually reads like "United Nations of Earth"
#: stellarisdashboard/dashboard_app/event_registry.py:REGISTRY[agenda_preparation]:10
#, python-format
msgid "The %(country)s prepared a new agenda \"%(agenda)s\"."
msgstr "L'empire %(country)s a préparé un nouvel agenda « %(agenda)s »."

#. %(attackers)s and %(defenders)s are lists of empires (links). The exhaustion values are the war
#. exhaustion of each side in percent, e.g. 12.5%. %(planet)s: name of a planet (a link). %(system)s:
#. name of a star system (a link). %(war)s: name of a war (a link)
#: stellarisdashboard/dashboard_app/event_registry.py:REGISTRY[army_combat]:6
#, python-format
msgid ""
"Invasion of planet %(planet)s in the %(system)s system: Attackers %(attackers)s "
"(%(attacker_exhaustion)s exhaustion) defeated %(defenders)s (exhaustion %(defender_exhaustion)s) "
"in the %(war)s."
msgstr ""
"Invasion de la planète %(planet)s dans le système %(system)s (%(war)s) : les attaquants "
"%(attackers)s (lassitude de guerre : %(attacker_exhaustion)s) ont vaincu %(defenders)s (lassitude"
" de guerre : %(defender_exhaustion)s)."

#. %(attackers)s and %(defenders)s are lists of empires (links). The exhaustion values are the war
#. exhaustion of each side in percent, e.g. 12.5%. %(planet)s: name of a planet (a link). %(system)s:
#. name of a star system (a link). %(war)s: name of a war (a link)
#: stellarisdashboard/dashboard_app/event_registry.py:REGISTRY[army_combat]:9
#, python-format
msgid ""
"Invasion of planet %(planet)s in the %(system)s system: Attackers %(attackers)s "
"(%(attacker_exhaustion)s exhaustion) were defeated by %(defenders)s (exhaustion "
"%(defender_exhaustion)s) in the %(war)s."
msgstr ""
"Invasion de la planète %(planet)s dans le système %(system)s (%(war)s) : les attaquants "
"%(attackers)s (lassitude de guerre : %(attacker_exhaustion)s) ont été vaincus par %(defenders)s "
"(lassitude de guerre : %(defender_exhaustion)s)."

#. %(leader)s: class and name of a leader (a link), e.g. "Scientist Jane Doe". %(country)s: name of an
#. empire (a link), usually reads like "United Nations of Earth"
#: stellarisdashboard/dashboard_app/event_registry.py:REGISTRY[ascension_perk]:6
#, python-format
msgid "%(leader)s ascended the %(country)s with \"%(perk)s\"."
msgstr "%(leader)s a fait accéder l'empire %(country)s à l'ascension « %(perk)s »."

#. %(country)s: name of an empire (a link), usually reads like "United Nations of Earth"
#: stellarisdashboard/dashboard_app/event_registry.py:REGISTRY[ascension_perk]:9
#, python-format
msgid "The %(country)s ascended with \"%(perk)s\"."
msgstr "L'empire %(country)s a accédé à l'ascension « %(perk)s »."

#. %(subject_type)s: the kind of subject, e.g. "Vassal". %(country)s: name of an empire (a link),
#. usually reads like "United Nations of Earth". %(target)s: name of another empire (a link), like
#. %(country)s
#: stellarisdashboard/dashboard_app/event_registry.py:REGISTRY[became_subject]:6
#, python-format
msgid "The %(country)s became a %(subject_type)s of the %(target)s."
msgstr "L'empire %(country)s est devenu %(subject_type)s de l'empire %(target)s."

#. %(leader)s: class and name of a leader (a link), e.g. "Scientist Jane Doe". %(country)s: name of an
#. empire (a link), usually reads like "United Nations of Earth". %(planet)s: name of a planet (a
#. link). %(system)s: name of a star system (a link)
#: stellarisdashboard/dashboard_app/event_registry.py:REGISTRY[capital_relocation]:7
#, python-format
msgid ""
"Under the rule of %(leader)s, the %(country)s relocated their capital to %(planet)s in the "
"%(system)s system."
msgstr ""
"Sous la direction de %(leader)s, l'empire %(country)s a transféré sa capitale sur %(planet)s dans"
" le système %(system)s."

#. %(country)s: name of an empire (a link), usually reads like "United Nations of Earth". %(planet)s:
#. name of a planet (a link). %(system)s: name of a star system (a link)
#: stellarisdashboard/dashboard_app/event_registry.py:REGISTRY[capital_relocation]:10
#, python-format
msgid "The %(country)s relocated their capital to %(planet)s in the %(system)s system."
msgstr "L'empire %(country)s a transféré sa capitale sur %(planet)s dans le système %(system)s."

#. %(leader)s: class and name of a leader (a link), e.g. "Scientist Jane Doe". %(country)s: name of an
#. empire (a link), usually reads like "United Nations of Earth". %(planet)s: name of a planet (a link)
#: stellarisdashboard/dashboard_app/event_registry.py:REGISTRY[capital_relocation]:15
#, python-format
msgid "Under the rule of %(leader)s, the %(country)s relocated their capital to %(planet)s."
msgstr "Sous la direction de %(leader)s, l'empire %(country)s a transféré sa capitale sur %(planet)s."

#. %(country)s: name of an empire (a link), usually reads like "United Nations of Earth". %(planet)s:
#. name of a planet (a link)
#: stellarisdashboard/dashboard_app/event_registry.py:REGISTRY[capital_relocation]:18
#, python-format
msgid "The %(country)s relocated their capital to %(planet)s."
msgstr "L'empire %(country)s a transféré sa capitale sur %(planet)s."

#. %(policy)s: the area of the policy, %(old_choice)s and %(new_choice)s: the options. %(leader)s:
#. class and name of a leader (a link), e.g. "Scientist Jane Doe". %(country)s: name of an empire (a
#. link), usually reads like "United Nations of Earth"
#: stellarisdashboard/dashboard_app/event_registry.py:REGISTRY[changed_policy]:6
#, python-format
msgid ""
"Under the rule of %(leader)s, the %(country)s changed their policy on '%(policy)s' from "
"'%(old_choice)s' to '%(new_choice)s'."
msgstr ""
"Sous la direction de %(leader)s, l'empire %(country)s a modifié sa politique « %(policy)s » : « "
"%(old_choice)s » est remplacé par « %(new_choice)s »."

#. %(policy)s: the area of the policy, %(old_choice)s and %(new_choice)s: the options. %(country)s:
#. name of an empire (a link), usually reads like "United Nations of Earth"
#: stellarisdashboard/dashboard_app/event_registry.py:REGISTRY[changed_policy]:9
#, python-format
msgid "The %(country)s changed their policy on '%(policy)s' from '%(old_choice)s' to '%(new_choice)s'."
msgstr ""
"L'empire %(country)s a modifié sa politique « %(policy)s » : « %(old_choice)s » est remplacé par "
"« %(new_choice)s »."

#. %(leader)s: class and name of a leader (a link), e.g. "Scientist Jane Doe". %(country)s: name of an
#. empire (a link), usually reads like "United Nations of Earth". %(target)s: name of another empire (a
#. link), like %(country)s
#: stellarisdashboard/dashboard_app/event_registry.py:REGISTRY[closed_borders]:7
#, python-format
