msgstr "abgewendet"

#. the state of a situation and how far its progress bar is filled, e.g. "in progress, 62%"
#: stellarisdashboard/dashboard_app/event_registry.py:1332
#, python-format
msgid "%(state)s, %(percent)s%%"
msgstr "%(state)s, %(percent)s%%"

