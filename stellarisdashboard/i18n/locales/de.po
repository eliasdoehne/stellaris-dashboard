#. a stage of a first contact and the empire that reached it, e.g.
#. "Communications established by the United Nations of Earth". %(country)s is the empire (a link)
#: stellarisdashboard/dashboard_app/event_registry.py:1362
#, python-format
msgid "%(detail)s by the %(country)s"
msgstr "%(detail)s durch %(country)s"

#. %(country)s: name of an empire (a link), usually reads like "United Nations of Earth"
#: stellarisdashboard/dashboard_app/event_registry.py:REGISTRY[acquired_relic]:2
#, python-format
msgid "The %(country)s acquired the \"%(relic)s\" relic."
msgstr "%(country)s erwarb das Relikt „%(relic)s“."

#. %(leader)s: class and name of a leader (a link), e.g. "Scientist Jane Doe". %(country)s: name of an
#. empire (a link), usually reads like "United Nations of Earth"
#: stellarisdashboard/dashboard_app/event_registry.py:REGISTRY[agenda_launch]:3
#, python-format
msgid "Under %(leader)s, the %(country)s launched the \"%(agenda)s\" agenda."
msgstr "Unter der Herrschaft von %(leader)s startete %(country)s die Agenda „%(agenda)s“."

#. %(country)s: name of an empire (a link), usually reads like "United Nations of Earth"
#: stellarisdashboard/dashboard_app/event_registry.py:REGISTRY[agenda_launch]:6
#, python-format
msgid "The %(country)s launched the \"%(agenda)s\" agenda."
msgstr "%(country)s startete die Agenda „%(agenda)s“."

#. %(leader)s: class and name of a leader (a link), e.g. "Scientist Jane Doe". %(country)s: name of an
#. empire (a link), usually reads like "United Nations of Earth"
#: stellarisdashboard/dashboard_app/event_registry.py:REGISTRY[agenda_preparation]:3
#, python-format
msgid "Under %(leader)s, the %(country)s prepared the \"%(agenda)s\" agenda."
msgstr "Unter der Herrschaft von %(leader)s bereitete %(country)s die Agenda „%(agenda)s“ vor."

#. %(country)s: name of an empire (a link), usually reads like "United Nations of Earth"
#: stellarisdashboard/dashboard_app/event_registry.py:REGISTRY[agenda_preparation]:6
#, python-format
msgid "The %(country)s prepared the \"%(agenda)s\" agenda."
msgstr "%(country)s bereitete die Agenda „%(agenda)s“ vor."

#. %(attackers)s and %(defenders)s are lists of empires (links) with their articles, e.g. "the A and
#. the B" (see the messages "the %%(name)s" and "The %%(name)s"). The exhaustion values are the war
#. exhaustion of each side in percent, e.g. 12.5%%. %(planet)s: name of a planet (a link). %(system)s:
