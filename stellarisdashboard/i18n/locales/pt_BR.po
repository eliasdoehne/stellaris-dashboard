#. a stage of a first contact and the empire that reached it, e.g.
#. "Communications established by the United Nations of Earth". %(country)s is the empire (a link)
#: stellarisdashboard/dashboard_app/event_registry.py:1306
#, python-format
msgid "%(detail)s by the %(country)s"
msgstr "%(detail)s pelo império %(country)s"

#. %(country)s: name of an empire (a link), usually reads like "United Nations of Earth"
#: stellarisdashboard/dashboard_app/event_registry.py:REGISTRY[acquired_relic]:2
#, python-format
msgid "The %(country)s acquired the \"%(relic)s\" relic."
msgstr "O império %(country)s adquiriu a relíquia \"%(relic)s\"."

#. %(leader)s: class and name of a leader (a link), e.g. "Scientist Jane Doe". %(country)s: name of an
#. empire (a link), usually reads like "United Nations of Earth"
#: stellarisdashboard/dashboard_app/event_registry.py:REGISTRY[agenda_launch]:3
#, python-format
msgid "Under %(leader)s, the %(country)s launched the \"%(agenda)s\" agenda."
msgstr "Sob o governo de %(leader)s, o império %(country)s lançou a agenda \"%(agenda)s\"."

#. %(country)s: name of an empire (a link), usually reads like "United Nations of Earth"
#: stellarisdashboard/dashboard_app/event_registry.py:REGISTRY[agenda_launch]:6
#, python-format
msgid "The %(country)s launched the \"%(agenda)s\" agenda."
msgstr "O império %(country)s lançou a agenda \"%(agenda)s\"."

#. %(leader)s: class and name of a leader (a link), e.g. "Scientist Jane Doe". %(country)s: name of an
#. empire (a link), usually reads like "United Nations of Earth"
#: stellarisdashboard/dashboard_app/event_registry.py:REGISTRY[agenda_preparation]:3
#, python-format
msgid "Under %(leader)s, the %(country)s prepared the \"%(agenda)s\" agenda."
msgstr "Sob o governo de %(leader)s, o império %(country)s preparou a agenda \"%(agenda)s\"."

#. %(country)s: name of an empire (a link), usually reads like "United Nations of Earth"
#: stellarisdashboard/dashboard_app/event_registry.py:REGISTRY[agenda_preparation]:6
#, python-format
msgid "The %(country)s prepared the \"%(agenda)s\" agenda."
msgstr "O império %(country)s preparou a agenda \"%(agenda)s\"."

#. %(attackers)s and %(defenders)s are lists of empires (links) with their articles, e.g. "the A and
#. the B" (see the messages "the %%(name)s" and "The %%(name)s"). The exhaustion values are the war
#. exhaustion of each side in percent, e.g. 12.5%%. %(planet)s: name of a planet (a link). %(system)s:
#. name of a star system (a link). %(war)s: name of a war (a link); a war without a name in the game
#. reads "Empire A vs Empire B war"
#: stellarisdashboard/dashboard_app/event_registry.py:REGISTRY[army_combat]:6
#, python-format
msgid ""
"%(attackers_first)s invaded the planet %(planet)s in the %(system)s system, defeating "
"%(defenders)s during the %(war)s (exhaustion: attackers %(attacker_exhaustion)s, defenders "
"%(defender_exhaustion)s)."
msgstr ""
"Invasão do planeta %(planet)s no sistema %(system)s por %(attackers_first)s, com vitória sobre "
"%(defenders)s (%(war)s) (exaustão de guerra: atacantes %(attacker_exhaustion)s, defensores "
"%(defender_exhaustion)s)."

#. %(attackers)s and %(defenders)s are lists of empires (links) with their articles, e.g. "the A and
#. the B" (see the messages "the %%(name)s" and "The %%(name)s"). The exhaustion values are the war
#. exhaustion of each side in percent, e.g. 12.5%%. %(planet)s: name of a planet (a link). %(system)s:
#. name of a star system (a link)
#: stellarisdashboard/dashboard_app/event_registry.py:REGISTRY[army_combat]:9
#, python-format
msgid ""
"%(attackers_first)s invaded the planet %(planet)s in the %(system)s system, defeating "
"%(defenders)s (exhaustion: attackers %(attacker_exhaustion)s, defenders %(defender_exhaustion)s)."
msgstr ""
"Invasão do planeta %(planet)s no sistema %(system)s por %(attackers_first)s, com vitória sobre "
"%(defenders)s (exaustão de guerra: atacantes %(attacker_exhaustion)s, defensores "
"%(defender_exhaustion)s)."

#. %(attackers)s and %(defenders)s are lists of empires (links) with their articles, e.g. "the A and
#. the B" (see the messages "the %%(name)s" and "The %%(name)s"). The exhaustion values are the war
#. exhaustion of each side in percent, e.g. 12.5%%. %(planet)s: name of a planet (a link). %(war)s:
#. name of a war (a link); a war without a name in the game reads "Empire A vs Empire B war"
#: stellarisdashboard/dashboard_app/event_registry.py:REGISTRY[army_combat]:14
