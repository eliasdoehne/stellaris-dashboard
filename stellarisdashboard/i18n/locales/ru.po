#: stellarisdashboard/bulk_import.py:176
#, python-format
msgid "No save files found for game %(game_id)s in %(save_path)s."
msgstr "Файлы сохранений игры %(game_id)s не найдены в папке %(save_path)s."

#: stellarisdashboard/bulk_import.py:252
msgid "all games"
msgstr "все игры"

#: stellarisdashboard/bulk_import.py:398
#, python-format
msgid "The save files folder %(save_path)s does not exist. Check the settings."
msgstr "Папка с сохранениями %(save_path)s не существует. Проверьте настройки."

#: stellarisdashboard/bulk_import.py:403
#, python-format
msgid "All saves of %(game_id)s are already imported."
msgstr "Все сохранения игры %(game_id)s уже импортированы."

#: stellarisdashboard/bulk_import.py:421 stellarisdashboard/bulk_import.py:429
msgid "There are no kept copies of failed saves to reprocess."
msgstr "Нет сохранённых копий неудачно обработанных сохранений для повторной обработки."

#: stellarisdashboard/bulk_import.py:452
#, python-format
msgid "An import of %(game_id)s is already running. Wait for it to finish or cancel it."
msgstr "Импорт игры %(game_id)s уже выполняется. Дождитесь его завершения или отмените его."

